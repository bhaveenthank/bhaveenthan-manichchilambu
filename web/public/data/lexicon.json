{"people":[{"form":"கண்ணகி","entity":"kannagi","line":"MAN-26-0002","source":"text","text":"தணியாக் காதல் தாய் கண்ணகியையும்"},{"form":"கோவலன்","entity":"kovalan","line":"SIL-16-0125","source":"text","text":"கோவலன் சென்றக் குறுமக னிருக்கையோர்"},{"form":"கௌசிகன்","entity":"kosikan","line":"SIL-13-0047","source":"text","note":"same man as கோசிக மாணி, six lines later","text":"கட்புல மயக்கத்துக் கௌசிகன் தெரியான்"},{"form":"கோசிக மாணி","entity":"kosikan","line":"SIL-13-0053","source":"text","text":"கோசிக மாணி கூறக் கேட்டே"},{"form":"பொய்த்தொழிற் கொல்லன்","entity":"goldsmith","line":"SIL-16-0120","source":"text","note":"the poet's word: the man of false craft","text":"பொய்த்தொழிற் கொல்லன் புரிந்துடன் நோக்கிக்"},{"form":"கூற்றத் தூதன்","entity":"goldsmith","line":"SIL-16-0115","source":"text","note":"messenger of death, used only inside this episode","text":"கூற்றத் தூதன் கைதொழு தேத்தப்"},{"form":"குருமகன்","entity":"naga_chief","line":"MAN-16-0064","source":"text","note":"a title, not a name","text":"ஈங்கு எம் குருமகன் இருந்தோன் அவன்பால்"}],"places":[{"form":"பூம்புகார்","entity":"puhar","line":"SIL-01-0010","source":"text","text":"பூம்புகார் போற்றுதும் பூம்புகார் போற்றுதும்"},{"form":"கூடல்","entity":"madurai","line":"SIL-14-0006","source":"text","text":"ஒங்குயர் கூடல் ஊர்துயி லெடுப்ப"},{"form":"மதுரை மூதூர்","entity":"madurai","line":"SIL-00-0039","source":"text","text":"அதிராச் சிறப்பின் மதுரை மூதூர்க்"},{"form":"வச்சிரக் கோட்டம்","entity":"vachira_temple","line":"SIL-09-0012","source":"text","text":"வச்சிரக் கோட்டம் புறம்பணையான் வாழ்கோட்டம்"}],"objects":[{"form":"சிலம்பு","entity":"ank_pair","line":"SIL-20-0080","source":"reading","note":"the king says யாமுடைச் சிலம்பு here and means the queen's, so the word alone never picks out one anklet","text":"யாமுடைச் சிலம்பு முத்துடை அரியே"},{"form":"அமுதசுரபி","entity":"amudasurabhi","line":"MAN-11-0044","source":"text","text":"ஆபுத்திரன் கை அமுதசுரபி எனும்"},{"form":"முத்தரை","entity":"pearl_girdle","line":"SIL-06-0087","source":"text","text":"பிறங்கிய முத்தரை முப்பத்து இருகாழ்"},{"form":"கடிஞை","entity":"amudasurabhi","line":"MAN-20-0085","source":"reading","note":"a begging bowl in general. It's this one only by context","text":"காயசண்டிகை ஆய் கடிஞை ஏந்தி"}],"foods":[{"form":"மாவின் கனி","entity":"mango","line":"SIL-16-0026","source":"text","text":"மாவின் கனியொடு வாழைத் தீங்கனி"},{"form":"தேமாங் கனி","entity":"mango","line":"SIL-25-0043","source":"text","text":"தெங்கின் பழனும் தேமாங் கனியும்"},{"form":"வாழைத் தீங்கனி","entity":"plantain","line":"SIL-16-0026","source":"text","text":"மாவின் கனியொடு வாழைத் தீங்கனி"},{"form":"குமரி வாழையின் குருத்த","entity":"plantain","line":"SIL-16-0042","source":"text","note":"the leaf, not the fruit. Same plant, different part","text":"குமரி வாழையின் குருத்தகம் விரித்தீங்கு"},{"form":"பலவின் பழங்க","entity":"jackfruit","line":"SIL-25-0044","source":"text","text":"பைங்கொடிப் படலையும் பலவின் பழங்களும்"},{"form":"கோளிப் பாகற்","entity":"koli_fruit","line":"SIL-16-0024","source":"reading","note":"read as jackfruit in the commentary tradition; the word பலா isn't here","text":"கோளிப் பாகற் கொழுங்கனித் திரள்காய்"}],"events":[{"form":"இந்திர விழவு","entity":"indra_festival","line":"SIL-06-0006","source":"text","text":"இந்திர விழவுகொண்டு எடுக்கும்நாள் இதுஎனக்"},{"form":"ஆயிரம்கண்ணோன் விழா","entity":"indra_festival","line":"MAN-01-0026","source":"text","text":"ஆயிரம்கண்ணோன் விழாக் கால்கொள்க' என"},{"form":"வானவன் விழாக் கோள்","entity":"indra_festival","line":"MAN-25-0197","source":"text","text":"வானவன் விழாக் கோள் மா நகர் ஒழிந்தது"}],"epithets":[{"form":"மதுரை மூதூர் மாநகர்","entity":"madurai","line":"SIL-11-0188","source":"text","meaning":"the old, great city of Madurai","text":"மதுரை மூதூர் மாநகர்ப் போந்தது"},{"form":"ஒங்குயர் கூடல்","entity":"madurai","line":"SIL-14-0006","source":"text","meaning":"lofty Kūṭal","text":"ஒங்குயர் கூடல் ஊர்துயி லெடுப்ப"},{"form":"கொடிமாடக் கூடலை","entity":"madurai","line":"SIL-24-0118","source":"text","meaning":"Kūṭal of the bannered mansions","text":"கோமுறை நீங்கக் கொடிமாடக் கூடலைத்"},{"form":"நான்மாடக் கூடல்","entity":"madurai","line":"SIL-21-0039","source":"text","meaning":"Kūṭal of the four mansions","text":"நான்மாடக் கூடல் மகளிரு மைந்தரும்"},{"form":"கலிகெழு கூடல்","entity":"madurai","line":"SIL-13-0149","source":"text","meaning":"bustling Kūṭal","text":"கார்க்கடல் ஒலியிற் கலிகெழு கூடல்"},{"form":"நிலைகெழு கூடல்","entity":"madurai","line":"SIL-00-0035","source":"text","meaning":"steadfast Kūṭal","text":"நிலைகெழு கூடல் நீள்எரி ஊட்டிய"},{"form":"மாபெருங் கூடல்","entity":"madurai","line":"SIL-23-0022","source":"text","meaning":"great Kūṭal","text":"மாபெருங் கூடல் மதுரா பதியென்பேன்"},{"form":"திருமலி மூதூர்","entity":"madurai","line":"SIL-13-0133","source":"text","meaning":"the old city rich in fortune, said of the Pandya's city","text":"நனிசேய்த் தன்றவன் திருமலி மூதூர்"},{"form":"மாட மூதூர்","entity":"madurai","line":"SIL-27-0061","source":"text","meaning":"the old city of mansions","text":"மாட மூதூர் மதுரை புக்காங்கு"}],"homonyms":[{"form":"கூடல்","senses":[{"entity":"madurai","line":"SIL-14-0006","en":"Madurai","ta":"மதுரை","text":"ஒங்குயர் கூடல் ஊர்துயி லெடுப்ப"},{"line":"SIL-06-0109","as":"கூடலும்","en":"lovers' union (கூடலும் ஊடலும்)","ta":"கூடுதல், புணர்ச்சி","text":"கூடலும் ஊடலும் கோவலற்கு அளித்துப்"}]},{"form":"ஐயை","senses":[{"entity":"aiyai_daughter","line":"SIL-16-0012","en":"Aiyai, Matari's daughter","ta":"மாதரியின் மகள்","text":"ஐயை காணீ ரடித்தொழி லாட்டி"},{"entity":"kavunti","line":"SIL-10-0045","en":"a title of respect for Kavunti","ta":"கவுந்திக்கான மரியாதைச் சொல்","text":"காவுந்தி ஐயையைக் கண்டுஅடி தொழலும்,"},{"line":"SIL-11-0216","en":"the goddess, at her temple","ta":"கொற்றவை (ஐயை கோட்டம்)","text":"ஐயைதன் கோட்டம் அடைந்தனர் ஆங்கென்."}]},{"form":"மணி","senses":[{"entity":"gemstone","line":"SIL-20-0078","en":"gem, inside Kannagi's anklet","ta":"இரத்தினம்","text":"என்காற் பொற்சிலம்பு மணியுடை அரியே, எனத்"},{"line":"SIL-23-0032","en":"the bell at the palace gate (மணிநா)","ta":"ஆராய்ச்சி மணி","text":"மணிநா வோசை கேட்டது மிலனே"}]},{"form":"மணிமேகலை","senses":[{"entity":"manimekalai","line":"MAN-03-0171","en":"the heroine","ta":"தலைவி","text":"மலர் கொய்யப் புகுந்தனள் மணிமேகலை என்"},{"line":"MAN-00-0097","en":"the poem itself (மணிமேகலை துறவு)","ta":"நூல்","text":"மா வண் தமிழ்த் திறம் மணிமேகலை துறவு"}]},{"form":"மணிமேகலா","senses":[{"entity":"manimekhala_deity","line":"MAN-06-0213","en":"the sea goddess, not the heroine","ta":"கடல் தெய்வம், தலைவி அல்ல","text":"மணிபல்லவத்திடை மணிமேகலா தெய்வம்"}]},{"form":"கோவல","senses":[{"entity":"kovalan","line":"SIL-16-0125","en":"Kovalan","ta":"கோவலன்","text":"கோவலன் சென்றக் குறுமக னிருக்கையோர்"},{"line":"SIL-16-0004","en":"cowherds (கோவலர்), on the very same page","ta":"இடையர்","text":"மிளைசூழ் கோவலர் இருக்கை யன்றிப்"}]},{"form":"சாதுவன்","senses":[{"entity":"saduvan","line":"MAN-16-0004","en":"Saduvan the merchant","ta":"வணிகன் சாதுவன்","text":"சாதுவன் என்போன் தகவு இலன் ஆகி"},{"line":"SIL-10-0182","en":"a title in praise of the Arhat","ta":"அருகனின் பெயர்","text":"தத்துவன் சாதுவன் சாரணன் காரணன்"}]},{"form":"மா","senses":[{"entity":"mango","line":"SIL-16-0026","en":"mango tree (மாவின் கனி)","ta":"மாமரம்","text":"மாவின் கனியொடு வாழைத் தீங்கனி"},{"line":"SIL-11-0188","en":"great (மாநகர்)","ta":"பெரிய","text":"மதுரை மூதூர் மாநகர்ப் போந்தது"}]},{"form":"கௌசிகன்","senses":[{"entity":"kosikan","line":"SIL-13-0047","en":"Kosikan the messenger","ta":"கோசிக மாணி","text":"கட்புல மயக்கத்துக் கௌசிகன் தெரியான்"},{"entity":"kausikan_campai","line":"MAN-03-0029","en":"Cutamati's father, a brahmin of Campai","ta":"சுதமதியின் தந்தை","text":"காராளர் சண்பையில் கௌசிகன் என்போன்"}]},{"form":"ஆரம்","senses":[{"line":"SIL-14-0108","as":"ஆரமு","en":"sandalwood, probably, beside agarwood and camphor","ta":"சந்தனம்","text":"அகிலும் துகிலும் ஆரமும் வாசமும்"},{"line":"SIL-11-0049","en":"a necklace","ta":"மாலை","text":"நலங்கிளர் ஆரம் மார்பிற் பூண்டு"}]},{"form":"கோவலன்","senses":[{"entity":"kovalan","line":"SIL-16-0125","en":"Kovalan 