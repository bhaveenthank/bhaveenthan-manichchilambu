uote":"இட்ட சாபம் கட்டியது ஆகலின்"},{"kind":"see","roles":{"agent":"kannagi","patient":"kovalan"},"voice":["poet","cattan","madurapati"],"mood":"predicted","lines":[{"id":"SIL-00-0050","text":"வார்ஒலி கூந்தல்நின் மணமகன் தன்னை"},{"id":"SIL-00-0051","text":"ஈர்ஏழ் நாளகத்து எல்லை நீங்கி"},{"id":"SIL-00-0052","text":"வானோர் தங்கள் வடிவின் அல்லதை"},{"id":"SIL-00-0053","text":"ஈனோர் வடிவில் காண்டல் இல்எனக்"}],"quote":"ஈனோர் வடிவில் காண்டல் இல்"},{"kind":"hear","roles":{"agent":"cattan","theme":"madurapati_speech"},"voice":["poet","cattan"],"mood":"asserted","lines":[{"id":"SIL-00-0054","text":"கோட்டம்இல் கட்டுரை கேட்டனன் யான்என,"}],"quote":"கோட்டம்இல் கட்டுரை கேட்டனன் யான்"},{"kind":"compose","roles":{"theme":"cilappatikaram"},"voice":["poet","cattan"],"mood":"intended","lines":[{"id":"SIL-00-0055","text":"அரைசியல் பிழைத்தோர்க்கு அறம்கூற்று ஆவதூஉம்"},{"id":"SIL-00-0056","text":"உரைசால் பத்தினிக்கு உயர்ந்தோர் ஏத்தலும்"},{"id":"SIL-00-0057","text":"ஊழ்வினை உருத்துவந்து ஊட்டும் என்பதூஉம்"},{"id":"SIL-00-0058","text":"சூழ்வினைச் சிலம்பு காரண மாகச்"},{"id":"SIL-00-0059","text":"சிலப்பதி காரம் என்னும் பெயரால்"},{"id":"SIL-00-0060","text":"நாட்டுதும் யாம்ஓர் பாட்டுடைச் செய்யுள்என,"}],"quote":"நாட்டுதும் யாம்ஓர் பாட்டுடைச் செய்யுள்"},{"kind":"request","roles":{"agent":"cattan","addressee":"ilanko"},"voice":["poet"],"mood":"asserted","lines":[{"id":"SIL-00-0061","text":"முடிகெழு வேந்தர் மூவர்க்கும் உரியது"},{"id":"SIL-00-0062","text":"அடிகள் நீரே அருளுகஎன் றார்க்குஅவர்,"}],"quote":"அடிகள் நீரே அருளுக"},{"kind":"grant_poem","roles":{"agent":"ilanko","theme":"cilappatikaram"},"voice":["poet","cattan"],"mood":"command","lines":[{"id":"SIL-00-0061","text":"முடிகெழு வேந்தர் மூவர்க்கும் உரியது"},{"id":"SIL-00-0062","text":"அடிகள் நீரே அருளுகஎன் றார்க்குஅவர்,"}],"quote":"முடிகெழு வேந்தர் மூவர்க்கும் உரியது"},{"kind":"belong_to","roles":{"recipient":"three_crowned_kings"},"voice":["poet","petitioners"],"mood":"claimed","lines":[{"id":"SIL-00-0061","text":"முடிகெழு வேந்தர் மூவர்க்கும் உரியது"}],"quote":"முடிகெழு வேந்தர் மூவர்க்கும் உரியது"},{"kind":"request","roles":{"addressee":"adigal"},"voice":["poet","petitioners"],"mood":"command","lines":[{"id":"SIL-00-0062","text":"அடிகள் நீரே அருளுகஎன் றார்க்குஅவர்,"}],"quote":"அடிகள் நீரே அருளுகஎன்"},{"kind":"enumerate_cantos","roles":{},"voice":["poet"],"mood":"asserted","lines":[{"id":"SIL-00-0063","text":"மங்கல வாழ்த்துப் பாடலும், குரவர்"},{"id":"SIL-00-0064","text":"மனையறம் படுத்த காதையும், நடம்நவில்"},{"id":"SIL-00-0065","text":"மங்கை மாதவி அரங்கேற்று காதையும்,"},{"id":"SIL-00-0066","text":"அந்தி மாலைச் சிறப்புசெய் காதையும்,"},{"id":"SIL-00-0067","text":"இந்திர விழவூர் எடுத்த காதையும்,"},{"id":"SIL-00-0068","text":"கடலாடு காதையும்,"},{"id":"SIL-00-0069","text":"மடல்அவிழ் கானல்வரியும், வேனில்வந் திறுத்தென"},{"id":"SIL-00-0070","text":"மாதவி இரங்கிய காதையும், தீதுடைக்"},{"id":"SIL-00-0071","text":"கனாத்திறம் உரைத்த காதையும், வினாத்திறத்து"},{"id":"SIL-00-0072","text":"நாடுகாண் காதையும், காடுகாண் காதையும்,"},{"id":"SIL-00-0073","text":"வேட்டுவர் வரியும், தோட்டலர் கோதையொடு"},{"id":"SIL-00-0074","text":"புறஞ்சேரி இறுத்த காதையும், கறங்குஇசை"},{"id":"SIL-00-0075","text":"ஊர்க்காண் காதையும், சீர்சால் நங்கை"},{"id":"SIL-00-0076","text":"அடைக்கலக் காதையும், கொலைக்களக் காதையும்,"},{"id":"SIL-00-0077","text":"ஆய்ச்சியர் குரவையும், தீத்திறம் கேட்ட"},{"id":"SIL-00-0078","text":"துன்ப மாலையும், நண்பகல் நடுங்கிய"},{"id":"SIL-00-0079","text":"ஊர்சூழ் வரியும், சீர்சால் வேந்தனொடு"},{"id":"SIL-00-0080","text":"வழக்குரை காதையும், வஞ்சின மாலையும்,"},{"id":"SIL-00-0081","text":"அழல்படு காதையும், அருந்தெய்வம் தோன்றிக்"},{"id":"SIL-00-0082","text":"கட்டுரை காதையும், மட்டலர் கோதையர்"},{"id":"SIL-00-0083","text":"குன்றக் குரவையும், என்றுஇவை அனைத்துடன்"},{"id":"SIL-00-0084","text":"காட்சி, கால்கோள், நீர்ப்படை, நடுகல்,"},{"id":"SIL-00-0085","text":"வாழ்த்து, வரந்தரு காதையொடு"}],"quote":"மங்கல வாழ்த்துப் பாடலும்"},{"kind":"grace_utter","roles":{"agent":"ilanko","theme":"verse_interspersed_with_prose"},"voice":["poet"],"mood":"asserted","lines":[{"id":"SIL-00-0087","text":"உரையிடை இட்ட பாட்டுடைச் செய்யுள்"},{"id":"SIL-00-0088","text":"உரைசால் அடிகள் அருள மதுரைக்"}],"quote":"உரைசால் அடிகள் அருள"},{"kind":"hear","roles":{"agent":"cattan","theme":"verse_interspersed_with_prose"},"voice":["poet"],"mood":"asserted","lines":[{"id":"SIL-00-0088","text":"உரைசால் அடிகள் அருள மதுரைக்"},{"id":"SIL-00-0089","text":"கூல வாணிகன் சாத்தன் கேட்டனன்,"}],"quote":"வாணிகன் சாத்தன் கேட்டனன்"},{"kind":"contain_verse","roles":{"theme":"nine_verse_cantos"},"voice":["poet"],"mood":"asserted","lines":[{"id":"SIL-00-0081","text":"அழல்படு காதையும், அருந்தெய்வம் தோன்றிக்"},{"id":"SIL-00-0082","text":"கட்டுரை காதையும், மட்டலர் கோதையர்"},{"id":"SIL-00-0083","text":"குன்றக் குரவையும், என்றுஇவை அனைத்துடன்"},{"id":"SIL-00-0084","text":"காட்சி, கால்கோள், நீர்ப்படை, நடுகல்,"},{"id":"SIL-00-0085","text":"வாழ்த்து, வரந்தரு காதையொடு"},{"id":"SIL-00-0086","text":"இவ்வா றைந்தும்"},{"id":"SIL-00-0087","text":"உரையிடை இட்ட பாட்டுடைச் செய்யுள்"}],"quote":"உரையிடை இட்ட பாட்டுடைச் செய்யுள்"},{"kind":"state_convention","roles":{"theme":"padikam_tradition"},"voice":["poet"],"mood":"asserted","lines":[{"id":"SIL-00-0090","text":"இது, பால்வகை தெரிந்த பதிகத்தின் மரபென்."}],"quote":"இது, பால்வகை தெரிந்த பதிகத்தின் மரபென்."}]