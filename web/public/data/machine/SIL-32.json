[{"kind":"complete","roles":{"theme":"silappathikaram"},"voice":["poet"],"mood":"asserted","lines":[{"id":"SIL-32-0018","text":"சிலப்பதி காரம் முற்றும்."},{"id":"SIL-32-0019","text":"முற்றும்."}],"quote":"சிலப்பதி காரம் முற்றும்"},{"kind":"conclude","roles":{"theme":"narrative_content"},"voice":["poet"],"mood":"asserted","lines":[{"id":"SIL-32-0017","text":"மணிமே கலைமேல் உரைப்பொருள் முற்றிய"}],"quote":"மணிமே கலைமேல் உரைப்பொருள் முற்றிய"},{"kind":"encompass","roles":{"theme":"aram_porul_inbam_agam_puram_and_performing_arts","place":"tamil_land"},"voice":["poet"],"mood":"asserted","lines":[{"id":"SIL-32-0001","text":"குமரி வேங்கடங் குணகுட கடலா"},{"id":"SIL-32-0002","text":"மண்டினி மருங்கிற் றண்டமிழ் வரைப்பிற்"},{"id":"SIL-32-0003","text":"செந்தமிழ் கொடுந்தமி ழென்றிரு பகுதியின்"},{"id":"SIL-32-0004","text":"ஐந்திணை மருங்கின் அறம்பொரு ளின்பம்"},{"id":"SIL-32-0005","text":"மக்கள் தேவ ரெனவிரு சார்க்கும்"},{"id":"SIL-32-0006","text":"ஒத்த மரபின் ஒழுக்கொடு புணர"},{"id":"SIL-32-0007","text":"எழுத்தொடு புணர்ந்தசொல் லகத்தெழு பொருளை"},{"id":"SIL-32-0008","text":"இழுக்கா யாப்பின் அகனும் புறனும்"},{"id":"SIL-32-0009","text":"அவற்று வழிப்படூஉஞ் செவ்விசிறந் தோங்கிய"},{"id":"SIL-32-0010","text":"பாடலும் எழாலும் பண்ணும் பாணியும்"},{"id":"SIL-32-0011","text":"அரங்கு விலக்கே ஆடலென் றனைத்தும்"},{"id":"SIL-32-0012","text":"ஒருங்குடன் தழீஇ உடம்படக் கிடந்த"},{"id":"SIL-32-0013","text":"வரியுங் குரவையுஞ் சேதமு மென்றிவை"},{"id":"SIL-32-0014","text":"தெரிவுறு வகையாற் செந்தமி ழியற்கையில்"}],"quote":"அறம்பொரு ளின்பம்"},{"kind":"reveal","roles":{"theme":"meaning_of_the_work"},"voice":["poet"],"mood":"asserted","lines":[{"id":"SIL-32-0015","text":"ஆடிநல் நிழலின் நீடிருங் குன்றம்"},{"id":"SIL-32-0016","text":"காட்டு வார்போற் கருத்துவெளிப் படுத்து"}],"quote":"கருத்துவெளிப் படுத்து"}]