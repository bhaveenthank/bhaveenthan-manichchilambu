n":66,"text":"ஈங்கு இவர் நும் குலத்து இருடி கணங்கள் என்று","who":[],"rec":[]},{"id":"MAN-13-0067","n":67,"text":"ஓங்கு உயர் பெருஞ் சிறப்பு உரைத்தலும் உண்டால்","who":[],"rec":[]},{"id":"MAN-13-0068","n":68,"text":"ஆவொடு வந்த அழி குலம் உண்டோ","who":[],"rec":[]},{"id":"MAN-13-0069","n":69,"text":"நான்மறை மாக்காள் நல் நூல் அகத்து?\" என","who":[],"rec":[]},{"id":"MAN-13-0070","n":70,"text":"ஆங்கு அவர் தம்முள் ஓர் அந்தணன் உரைக்கும்","who":[],"rec":[]},{"id":"MAN-13-0071","n":71,"text":"\"ஈங்கு இவன் தன் பிறப்பு யான் அறிகுவன்\" என","who":[],"rec":["v104"]},{"id":"MAN-13-0072","n":72,"text":"\"நடவை வருத்தமொடு நல்கூர் மேனியள்","who":[],"rec":[]},{"id":"MAN-13-0073","n":73,"text":"வடமொழியாட்டி மறை முறை எய்தி","who":[],"rec":[]},{"id":"MAN-13-0074","n":74,"text":"குமரி பாதம் கொள்கையின் வணங்கி","who":[],"rec":[]},{"id":"MAN-13-0075","n":75,"text":"தமரின் தீர்ந்த சாலி என்போள் தனை","who":[],"rec":["v104"]},{"id":"MAN-13-0076","n":76,"text":"'யாது நின் ஊர்? ஈங்கு என் வரவு?' என","who":[],"rec":[]},{"id":"MAN-13-0077","n":77,"text":"மா மறையாட்டி வரு திறம் உரைக்கும்","who":[],"rec":[]},{"id":"MAN-13-0078","n":78,"text":"'வாரணாசி ஓர் மா மறை முதல்வன்","who":[],"rec":[]},{"id":"MAN-13-0079","n":79,"text":"ஆரண உவாத்தி அரும் பெறல் மனைவி யான்","who":[],"rec":[]},{"id":"MAN-13-0080","n":80,"text":"பார்ப்பார்க்கு ஒவ்வாப் பண்பின் ஒழுகி","who":[],"rec":[]},{"id":"MAN-13-0081","n":81,"text":"காப்புக் கடைகழிந்து கணவனை இகழ்ந்தேன்","who":[],"rec":[]},{"id":"MAN-13-0082","n":82,"text":"எறி பயம் உடைமையின் இரியல் மாக்களொடு","who":[],"rec":[]},{"id":"MAN-13-0083","n":83,"text":"தெற்கண் குமரி ஆடிய வருவேன்","who":[],"rec":[]},{"id":"MAN-13-0084","n":84,"text":"பொன் தேர்ச் செழியன் கொற்கை அம் பேர் ஊர்க்","who":[],"rec":[]},{"id":"MAN-13-0085","n":85,"text":"காவதம் கடந்து கோவலர் இருக்கையின்","who":[],"rec":[]},{"id":"MAN-13-0086","n":86,"text":"ஈன்ற குழவிக்கு இரங்கேனாகித்","who":[],"rec":[]},{"id":"MAN-13-0087","n":87,"text":"தோன்றாத் துடவையின் இட்டனன் போந்தேன்","who":[],"rec":[]},{"id":"MAN-13-0088","n":88,"text":"செல் கதி உண்டோ தீவினையேற்கு?' என்று","who":[],"rec":[]},{"id":"MAN-13-0089","n":89,"text":"அல்லல் உற்று அழுத அவள் மகன் ஈங்கு இவன்","who":[],"rec":["v104"]},{"id":"MAN-13-0090","n":90,"text":"சொல்லுதல் தேற்றேன் சொல் பயம் இன்மையின்","who":[],"rec":[]},{"id":"MAN-13-0091","n":91,"text":"புல்லல் ஓம்பன்மின் புலை மகன் இவன்\" என","who":[],"rec":[]},{"id":"MAN-13-0092","n":92,"text":"ஆபுத்திரன் பின்பு அமர் நகை செய்து","who":["aputhiran"],"rec":[]},{"id":"MAN-13-0093","n":93,"text":"\"மா மறை மாக்கள் வரும் குலம் கேண்மோ","who":[],"rec":[]},{"id":"MAN-13-0094","n":94,"text":"முது மறை முதல்வன் முன்னர்த் தோன்றிய","who":[],"rec":[]},{"id":"MAN-13-0095","n":95,"text":"கடவுள் கணிகை காதல் அம் சிறுவர்","who":[],"rec":[]},{"id":"MAN-13-0096","n":96,"text":"அரு மறை முதல்வர் அந்தணர் இருவரும்","who":[],"rec":[]},{"id":"MAN-13-0097","n":97,"text":"புரி நூல் மார்பீர்! பொய் உரை ஆமோ?","who":[],"rec":[]},{"id":"MAN-13-0098","n":98,"text":"சாலிக்கு உண்டோ தவறு?' என உரைத்து","who":[],"rec":[]},{"id":"MAN-13-0099","n":99,"text":"நான்மறை மாக்களை நகுவனன் நிற்ப","who":[],"rec":[]},{"id":"MAN-13-0100","n":100,"text":"\"ஓதல் அந்தணர்க்கு ஒவ்வான்\" என்றே","who":[],"rec":[]},{"id":"MAN-13-0101","n":101,"text":"தாதை பூதியும் தன் மனை கடிதர","who":[],"rec":["v105"]},{"id":"MAN-13-0102","n":102,"text":"\"ஆ கவர் கள்வன்\" என்று அந்தணர் உறைதரும்","who":[],"rec":["v105"]},{"id":"MAN-13-0103","n":103,"text":"கிராமம் எங்கணும் கடிஞையில் கல் இட","who":[],"rec":["v105"]},{"id":"MAN-13-0104","n":104,"text":"மிக்க செல்வத்து விளங்கியோர் வாழும்","who":[],"rec":[]},{"id":"MAN-13-0105","n":105,"text":"தக்கண மதுரை தான் சென்று எய்தி","who":["madurai"],"rec":["v106"]},{"id":"MAN-13-0106","n":106,"text":"சிந்தா விளக்கின் செழுங் கலை நியமத்து","who":[],"rec":["v106"]},{"id":"MAN-13-0107","n":107,"text":"அந்தில் முன்றில் அம்பலப் பீடிகைத்","who":[],"rec":[]},{"id":"MAN-13-0108","n":108,"text":"தங்கினன் வதிந்து அத் தக்கணப் பேர் ஊர்","who":[],"rec":[]},{"id":"MAN-13-0109","n":109,"text":"ஐயக் கடிஞை கையின் ஏந்தி","who":[],"rec":[]},{"id":"MAN-13-0110","n":110,"text":"மை அறு சிறப்பின் மனைதொறும் மறுகி","who":[],"rec":[]},{"id":"MAN-13-0111","n":111,"text":"'காணார் கேளார் கால் முடப்பட்டோர்","who":[],"rec":[]},{"id":"MAN-13-0112","n":112,"text":"பேணுநர் இல்லோர் பிணி நடுக்குற்றோர்","who":[],"rec":[]},{"id":"MAN-13-0113","n":113,"text":"யாவரும் வருக' என்று இசைத்து உடன் ஊட்டி","who":[],"rec":["v106"]},{"id":"MAN-13-0114","n":114,"text":"உண்டு ஒழி மிச்சில் உண்டு ஓடு தலை மடுத்து","who":[],"rec":[]},{"id":"MAN-13-0115","n":115,"text":"கண்படைகொள்ளும் காவலன் தான் என்","who":[],"rec":[]}]