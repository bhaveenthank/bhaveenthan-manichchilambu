[{"id":"MAN-27-0001","n":1,"text":"'நவை அறு நன் பொருள் உரைமினோ' என","who":[],"rec":[]},{"id":"MAN-27-0002","n":2,"text":"சமயக் கணக்கர் தம் திறம் சார்ந்து","who":[],"rec":[]},{"id":"MAN-27-0003","n":3,"text":"வைதிக மார்க்கத்து அளவை வாதியை","who":[],"rec":["x80"]},{"id":"MAN-27-0004","n":4,"text":"எய்தினள் எய்தி 'நின் கடைப்பிடி இயம்பு' என","who":[],"rec":["x80"]},{"id":"MAN-27-0005","n":5,"text":"'வேத வியாதனும் கிருதகோடியும்","who":[],"rec":[]},{"id":"MAN-27-0006","n":6,"text":"ஏதம் இல் சைமினி எனும் இவ் ஆசிரியர்","who":[],"rec":[]},{"id":"MAN-27-0007","n":7,"text":"பத்தும் எட்டும் ஆறும் பண்புறத்","who":[],"rec":[]},{"id":"MAN-27-0008","n":8,"text":"தம் தம் வகையால் தாம் பகர்ந்திட்டனர்","who":[],"rec":[]},{"id":"MAN-27-0009","n":9,"text":"காண்டல் கருதல் உவமம் ஆகமம்","who":[],"rec":[]},{"id":"MAN-27-0010","n":10,"text":"ஆண்டைய அருத்தாபத்தியோடு இயல்பு","who":[],"rec":[]},{"id":"MAN-27-0011","n":11,"text":"ஐதிகம் அபாவம் மீட்சி ஒழிவறிவு","who":[],"rec":[]},{"id":"MAN-27-0012","n":12,"text":"எய்தி உண்டாம் நெறி என்று இவை தம்மால்","who":[],"rec":[]},{"id":"MAN-27-0013","n":13,"text":"பொருளின் உண்மை புலங்கொளல் வேண்டும்","who":[],"rec":["x81"]},{"id":"MAN-27-0014","n":14,"text":"மருள் இல் காட்சி ஐ வகை ஆகும்","who":[],"rec":[]},{"id":"MAN-27-0015","n":15,"text":"கண்ணால் வண்ணமும் செவியால் ஓசையும்","who":[],"rec":[]},{"id":"MAN-27-0016","n":16,"text":"நண்ணிய மூக்கால் நாற்றமும் நாவால்","who":[],"rec":[]},{"id":"MAN-27-0017","n":17,"text":"சுவையும் மெய்யால் ஊறும் எனச் சொன்ன","who":[],"rec":[]},{"id":"MAN-27-0018","n":18,"text":"இவை இவை கண்டு கேட்டு உயிர்த்து உண்டு உற்று","who":[],"rec":[]},{"id":"MAN-27-0019","n":19,"text":"துக்கமும் சுகமும் எனத் துயக்கு அற அறிந்து","who":[],"rec":[]},{"id":"MAN-27-0020","n":20,"text":"உயிரும் வாயிலும் மனமும் ஊறு இன்றி","who":[],"rec":[]},{"id":"MAN-27-0021","n":21,"text":"பயில் ஒளியொடு பொருள் இடம் பழுது இன்றி","who":[],"rec":[]},{"id":"MAN-27-0022","n":22,"text":"சுட்டல் திரிதல் கவர்கோடல் தோன்றாது","who":[],"rec":[]},{"id":"MAN-27-0023","n":23,"text":"கிட்டிய தேசம் நாமம் சாதி","who":[],"rec":[]},{"id":"MAN-27-0024","n":24,"text":"குணம் கிரியையின் அறிவது ஆகும்","who":[],"rec":[]},{"id":"MAN-27-0025","n":25,"text":"கருத்து அளவு ஆவது","who":[],"rec":[]},{"id":"MAN-27-0026","n":26,"text":"குறிக்கொள் அனுமானத்து அனுமேயத்","who":[],"rec":[]},{"id":"MAN-27-0027","n":27,"text":"தகைமை உணரும் தன்மையது ஆகும்","who":[],"rec":[]},{"id":"MAN-27-0028","n":28,"text":"மூ வகை உற்று அது பொது எச்சம் முதல் ஆம்","who":[],"rec":[]},{"id":"MAN-27-0029","n":29,"text":"பொது எனப்படுவது சாதன சாத்தியம்","who":[],"rec":[]},{"id":"MAN-27-0030","n":30,"text":"இவை அந்நுவயம் இன்றாய் இருந்தும்","who":[],"rec":[]},{"id":"MAN-27-0031","n":31,"text":"கடம் திகழ் யானைக் கான ஒலி கேட்டோன்","who":[],"rec":[]},{"id":"MAN-27-0032","n":32,"text":"உடங்கு \"எழில் யானை அங்கு உண்டு\" என உணர்தல்","who":[],"rec":[]},{"id":"MAN-27-0033","n":33,"text":"எச்சம் என்பது வெள்ள ஏதுவினால்","who":[],"rec":[]},{"id":"MAN-27-0034","n":34,"text":"நிச்சயித்து அத் தலை மழை நிகழ்வு உரைத்தல்","who":[],"rec":[]},{"id":"MAN-27-0035","n":35,"text":"முதல் என மொழிவது கருக்கொள் முகில் கண்டு","who":[],"rec":[]},{"id":"MAN-27-0036","n":36,"text":"\"இது மழை பெய்யும் என இயம்பிடுதல்","who":[],"rec":[]},{"id":"MAN-27-0037","n":37,"text":"என்னும் ஏதுவின் ஒன்று முக் காலம்","who":[],"rec":[]},{"id":"MAN-27-0038","n":38,"text":"தன்னில் ஒன்றில் சார்ந்து உளதாகி","who":[],"rec":[]},{"id":"MAN-27-0039","n":39,"text":"மண்ட உயிர் முதல் மாசு இன்றாகி","who":[],"rec":[]},{"id":"MAN-27-0040","n":40,"text":"காண்டல் பொருளால் கண்டிலது உணர்தல்","who":[],"rec":[]},{"id":"MAN-27-0041","n":41,"text":"உவமம் ஆவது ஒப்புமை அளவை","who":[],"rec":[]},{"id":"MAN-27-0042","n":42,"text":"\"கவய மா ஆப் போலும்\" எனக் கருதல்","who":[],"rec":[]},{"id":"MAN-27-0043","n":43,"text":"ஆகம அளவை அறிவன் நூலால்","who":[],"rec":[]},{"id":"MAN-27-0044","n":44,"text":"\"போக புவனம் உண்டு\" எனப் புலங்கொளல்","who":[],"rec":[]},{"id":"MAN-27-0045","n":45,"text":"அருத்தாபத்தி \"ஆய்க்குடி கங்கை","who":[],"rec":[]},{"id":"MAN-27-0046","n":46,"text":"இருக்கும்\" என்றால் கரையில் என்று எண்ணல்","who":[],"rec":[]},{"id":"MAN-27-0047","n":47,"text":"இயல்பு யானைமேல் இருந்தோன் தோட்டிற்கு","who":[],"rec":[]},{"id":"MAN-27-0048","n":48,"text":"அயல் ஒன்று ஈயாது அதுவே கொடுத்தல்","who":[],"rec":[]},{"id":"MAN-27-0049","n":49,"text":"ஐதிகம் என்பது உலகு மறை \"இம் மரத்து","who":[],"rec":[]},{"id":"MAN-27-0050","n":50,"text":"எய்தியது ஓர் பேய் உண்டு\" எனத் தௌிதல்","who":[],"rec":[]},{"id":"MAN-27-0051","n":51,"text":"அபாவம் என்பது இன்மை \"ஓர் பொருளைத்","who":[],"rec":[]},{"id":"MAN-27-0052","n":52,"text":"தவாது அவ் இடத்துத் தான் இலை\" என்றல்","who":[],"rec":[]},{"id":"MAN-27-0053","n":53,"text":"மீட்சி என்பது \"இராமன் வென்றான்\" என","who":[],"rec":[]},{"id":"MAN-27-0054","n":54,"text":"மாட்சி இல் இராவணன் தோற்றமை மதித்தல்","who":[],"rec":[]},{"id":"MAN-27-0055","n":55,"text":"உள்ள நெறி என்பது \"நாராசத் திரிவில்","who":[],"rec":[]},{"id":"MAN-27-0056","n":56,"text":"கொள்ளத் தகுவது காந்தம்\" எனக் கூறல்","who":[],"rec":[]},{"id":"MAN-27-0057","n":57,"text":"எட்டு உள பிரமாண ஆபாசங்கள்","who":[],"rec":[]},{"id":"MAN-27-0058","n":58,"text":"சுட்டுணர்வொடு திரியக் கோடல் ஐயம்","who":[],"rec":[]},{"id":"MAN-27-0059","n":59,"text":"தேராது தௌிதல் கண்டு உணராமை","who":[],"rec":[]},{"id":"MAN-27-0060","n":60,"text":"எய்தும் இல் வழக்கு உணர்ந்ததை உணர்தல்","who":[],"rec":[]},{"id":"MAN-27-0061","n":61,"text":"நினைப்பு என நிகழ்வ சுட்டுணர்வு எனப்படுவது","who":[],"rec":[]},{"id":"MAN-27-0062","n":62,"text":"எனைப் பொருள் உண்மை மாத்திரை காண்டல்","who":[],"rec":[]},{"id":"MAN-27-0063","n":63,"text":"திரியக் கோடல் ஒன்றை ஒன்று என்றல்","who":[],"rec":[]},{"id":"MAN-27-0064","n":64,"text":"விரி கதிர் இப்பியை வெள்ளி என்று உணர்தல்","who":[],"rec":[]},{"id":"MAN-27-0065","n":65,"text":"ஐயம் என்பது ஒன்றை நிச்சயியா","who":[],"rec":[]},{"id":"MAN-27-0066","n":66,"text":"மையல் தறியோ? மகனோ? என்றல்","who":[],"rec":[]},{"id":"MAN-27-0067","n":67,"text":"தேராது தௌிதல் செண்டு வௌியில்","who":[],"rec":[]},{"id":"MAN-27-0068","n":68,"text":"ஓராது தறியை மகன் என உணர்தல