[{"id":"SIL-24-0001","n":1,"text":"உரைப்பாட்டு மடை","who":[],"rec":[]},{"id":"SIL-24-0002","n":2,"text":"குருவியோப்பியும் கிளிகடிந்தும் குன்றத்துச் சென்றுவைகி","who":[],"rec":[]},{"id":"SIL-24-0003","n":3,"text":"அருவியாடியும் சுனைகுடைந்தும் அலவுற்று வருவேம்முன்","who":[],"rec":[]},{"id":"SIL-24-0004","n":4,"text":"மலைவேங்கை நறுநிழலின் வள்ளிபோல்வீர் மனநடுங்க","who":[],"rec":[]},{"id":"SIL-24-0005","n":5,"text":"முலையிழந்து வந்துநின்றீர் யாவிரோவென முனியாதே","who":[],"rec":[]},{"id":"SIL-24-0006","n":6,"text":"மணமதுரையோ டரசுகேடுற வல்வினைவந் துருத்தகாலைக்","who":[],"rec":[]},{"id":"SIL-24-0007","n":7,"text":"கணவனையங்கு இழந்துபோந்த கடுவினையேன் யானென்றாள்","who":[],"rec":["x90"]},{"id":"SIL-24-0008","n":8,"text":"என்றலும் இறைஞ்சியஞ் இணைவளைக்கை எதிர்கூப்பி","who":[],"rec":[]},{"id":"SIL-24-0009","n":9,"text":"நின்றஎல்லையுள் வானவரும் நெடுமாரி மலர்பொழிந்து","who":[],"rec":["x91"]},{"id":"SIL-24-0010","n":10,"text":"குன்றவரும் கண்டுநிற்பக் கொழுநனொடு கொண்டுபோயினார்","who":[],"rec":["x91"]},{"id":"SIL-24-0011","n":11,"text":"இவள்போலும் நங்குலக்கோர் இருந்தெய்வம் இல்லையாதலின்","who":[],"rec":[]},{"id":"SIL-24-0012","n":12,"text":"சிறுகுடி யீரே சிறுகுடி யீரே","who":[],"rec":[]},{"id":"SIL-24-0013","n":13,"text":"தெய்வங் கொள்ளுமின் சிறுகுடி யீரே","who":[],"rec":["x92"]},{"id":"SIL-24-0014","n":14,"text":"நிறங்கிளர் அருவிப் பறம்பின் தாழ்வரை","who":[],"rec":[]},{"id":"SIL-24-0015","n":15,"text":"நறுஞ்சினை வேங்கை நன்னிழற் கீழோர்","who":[],"rec":[]},{"id":"SIL-24-0016","n":16,"text":"தெய்வங் கொள்ளுமின் சிறுகுடி யீரே","who":[],"rec":[]},{"id":"SIL-24-0017","n":17,"text":"தொண்டகம் தொடுமின் சிறுபறை தொடுமின்","who":[],"rec":[]},{"id":"SIL-24-0018","n":18,"text":"கோடுவாய் வைம்மின் கொடுமணி இயக்குமின்","who":[],"rec":[]},{"id":"SIL-24-0019","n":19,"text":"குறிஞ்சி பாடுமின் நறும்புகை எடுமின்","who":[],"rec":[]},{"id":"SIL-24-0020","n":20,"text":"பூப்பலி செய்ம்மின் காப்புக்கடை நிறுமின்","who":[],"rec":[]},{"id":"SIL-24-0021","n":21,"text":"பரவுலும் பரவுமின் விரவுமலர் தூவுமின்","who":[],"rec":[]},{"id":"SIL-24-0022","n":22,"text":"ஒருமுலை இழந்த நங்கைக்குப்","who":[],"rec":[]},{"id":"SIL-24-0023","n":23,"text":"பெருமலை துஞ்சாது வளஞ்சுரக் கெனவே;","who":[],"rec":[]},{"id":"SIL-24-0024","n":24,"text":"கொளுச் சொல்","who":[],"rec":[]},{"id":"SIL-24-0025","n":25,"text":"ஆங்கொன்று காணாய் அணியிழாய் ஈங்கிதுகாண்","who":[],"rec":[]},{"id":"SIL-24-0026","n":26,"text":"அஞ்சனப் பூமி யரிதாரத் தின்னிடியல்","who":[],"rec":[]},{"id":"SIL-24-0027","n":27,"text":"சிந்துரச் சுண்ணஞ் செறியத் தூய்த் தேங்கமழ்ந்து","who":[],"rec":[]},{"id":"SIL-24-0028","n":28,"text":"இந்திர வில்லின் எழில்கொண் டிழுமென்று","who":[],"rec":[]},{"id":"SIL-24-0029","n":29,"text":"வந்தீங் கிழியு மலையருவி யாடுதுமே;","who":[],"rec":[]},{"id":"SIL-24-0030","n":30,"text":"ஆடுதுமே தோழி யாடுதுமே தோழி","who":[],"rec":[]},{"id":"SIL-24-0031","n":31,"text":"அஞ்சலோம் பென்று நலனுண்டு நல்காதான்","who":[],"rec":[]},{"id":"SIL-24-0032","n":32,"text":"மஞ்சுசூழ் சோலை மலையருவி ஆடுதுமே;","who":[],"rec":[]},{"id":"SIL-24-0033","n":33,"text":"எற்றொன்றும் காணேம் புலத்தல் அவர்மலைக்","who":[],"rec":[]},{"id":"SIL-24-0034","n":34,"text":"கற்றீண்டி வந்த புதுப்புனல்","who":[],"rec":[]},{"id":"SIL-24-0035","n":35,"text":"கற்றீண்டி வந்த புதுப்புனல் மற்றையார்","who":[],"rec":[]},{"id":"SIL-24-0036","n":36,"text":"உற்றாடி னோம்தோழி நெஞ்சன்றே;","who":[],"rec":[]},{"id":"SIL-24-0037","n":37,"text":"என்னொன்றும் காணேம் புலத்தல் அவர்மலைப்","who":[],"rec":[]},{"id":"SIL-24-0038","n":38,"text":"பொன்னாடி வந்த புதுப்புனல்","who":[],"rec":[]},{"id":"SIL-24-0039","n":39,"text":"பொன்னாடி வந்த புதுப்புனல் மற்றையார்","who":[],"rec":[]},{"id":"SIL-24-0040","n":40,"text":"முன்னாடி னோம்தோழி நெஞ்சன்றே;","who":[],"rec":[]},{"id":"SIL-24-0041","n":41,"text":"யாதொன்றுங் காணேம் புலத்தல் அவர்மலைப்","who":[],"rec":[]},{"id":"SIL-24-0042","n":42,"text":"போதாடி வந்த புதுப்புனல்","who":[],"rec":[]},{"id":"SIL-24-0043","n":43,"text":"போதாடி வந்த புதுப்புனல் மற்றையார்","who":[],"rec":[]},{"id":"SIL-24-0044","n":44,"text":"மீதாடி னோம்தோழி நெஞ்சன்றே;","who":[],"rec