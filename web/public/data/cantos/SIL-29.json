[{"id":"SIL-29-0001","n":1,"text":"உரைப் பாட்டு மடை","who":[],"rec":[]},{"id":"SIL-29-0002","n":2,"text":"குமரியொடு வடவிமயத் தொருமொழிவைத் துலகாண்ட","who":[],"rec":[]},{"id":"SIL-29-0003","n":3,"text":"சேரலாதற்குத் திகழொளி ஞாயிற்றுச் சோழன்மகளீன்ற","who":[],"rec":[]},{"id":"SIL-29-0004","n":4,"text":"மைந்தன் கொங்கர் செங்களம் வேட்டுக் கங்கைப் பேர்","who":[],"rec":[]},{"id":"SIL-29-0005","n":5,"text":"யாற்றுக் கரைபோகிய செங்குட்டுவன் சினஞ் செருக்கி","who":["cenkuttuvan"],"rec":[]},{"id":"SIL-29-0006","n":6,"text":"வஞ்சியுள் வந்திருந்த காலை, வட ஆரிய மன்னர் ஆங்","who":["vanci"],"rec":[]},{"id":"SIL-29-0007","n":7,"text":"கோர் மடவரலை மாலைசூட்டி உடனுறைந்த இருக்கை","who":[],"rec":[]},{"id":"SIL-29-0008","n":8,"text":"தன்னில் ஒன்றுமொழி நகையினராய்த் தென்றமிழ் நாடா","who":[],"rec":[]},{"id":"SIL-29-0009","n":9,"text":"ளும் வேந்தர் செருவேட்டுப் புகன்றெழுந்து மின்றவழும்","who":[],"rec":[]},{"id":"SIL-29-0010","n":10,"text":"இமய நெற்றியில் விளங்கு வில் புலி கயல் பொறித்த","who":[],"rec":[]},{"id":"SIL-29-0011","n":11,"text":"நாள் எம்போலும் முடிமன்னர் ஈங்கில்லை போலும் என்ற","who":[],"rec":[]},{"id":"SIL-29-0012","n":12,"text":"வார்த்தை அங்குவாழும் மாதவர் வந்தறிவுறுத்தவிடத்","who":[],"rec":[]},{"id":"SIL-29-0013","n":13,"text":"தாங்கண் உருள்கின்ற மணிவட்டைக் குணில்கொண்டு","who":[],"rec":[]},{"id":"SIL-29-0014","n":14,"text":"துரந்ததுபோல் இமயமால்வரைக் கற்கடவுளாமென்ற","who":[],"rec":[]},{"id":"SIL-29-0015","n":15,"text":"வார்த்தை இடந்துரப்ப, ஆரியநாட்டரசோட்டி அவர்","who":[],"rec":[]},{"id":"SIL-29-0016","n":16,"text":"முடித்தலை அணங்காகிய பேரிமயக் கல்சுமத்திப்","who":[],"rec":[]},{"id":"SIL-29-0017","n":17,"text":"பெயர்ந்து போந்து நயந்த கொள்கையிற் கங்கைப்பேர்","who":[],"rec":[]},{"id":"SIL-29-0018","n":18,"text":"யாற்றிருந்து நங்கைதன்னை நீர்ப்படுத்தி வெஞ்சினந்தரு","who":[],"rec":[]},{"id":"SIL-29-0019","n":19,"text":"வெம்மை நீங்கி வஞ்சிமா நகர்புகுந்து நிலவரசர் நீண்","who":["vanci"],"rec":[]},{"id":"SIL-29-0020","n":20,"text":"முடியாற் பலர்தொழு படிமங் காட்டித் தடமுலைப் பூச","who":[],"rec":[]},{"id":"SIL-29-0021","n":21,"text":"லாட்டியைக் கடவுண் மங்கலஞ்செய்தபின்னாள் கண்ணகி","who":["kannagi"],"rec":[]},{"id":"SIL-29-0022","n":22,"text":"தன் கோட்டத்து மண்ணரசர் திறைகேட்புழி, அலம்வந்த","who":[],"rec":[]},{"id":"SIL-29-0023","n":23,"text":"மதிமுகத்திற் சில செங்கயல் நீர் உமிழப் பொடியாடிய","who":[],"rec":[]},{"id":"SIL-29-0024","n":24,"text":"கருமுகில்தன் புறம்புதைப்ப அறம்பழித்துக் கோவலன்றன்","who":["kovalan"],"rec":[]},{"id":"SIL-29-0025","n":25,"text":"வினையுருத்துக் குறுமகனாற் கொலையுன்ன காவலன்","who":[],"rec":[]},{"id":"SIL-29-0026","n":26,"text":"றன் இடஞ்சென்ற கண்ணகிதன் கண்ணீர்கண்டு மன்","who":["kannagi"],"rec":[]},{"id":"SIL-29-0027","n":27,"text":"னரசர் பெருந்தோன்றல் உண்ணீரற் றுயிரிழந்தமை","who":[],"rec":[]},{"id":"SIL-29-0028","n":28,"text":"மாமறையோன் வாய்கேட்டு மாசாத்துவான் தான்றுறப்","who":["masattuvan"],"rec":[]},{"id":"SIL-29-0029","n":29,"text":"பவும் மனைக்கிழத்தி உயிரிழப்பவும் எனைப் பெருந்","who":[],"rec":[]},{"id":"SIL-29-0030","n":30,"text":"துன்பமெய்திக் காவற்பெண்டும் அடித்தோழியும் கடவுட்","who":[],"rec":["v064"]},{"id":"SIL-29-0031","n":31,"text":"சாத்தனுடன் உறைந்த தேவந்தியும் உடன்கூடிச் சேயி","who":["tevanti"],"rec":["v064"]},{"id":"SIL-29-0032","n":32,"text":"ழையைக் காண்டுமென்று மதுரைமாநகர் புகுந்து முதிரா","who":["madurai"],"rec":["v064"]},{"id":"SIL-29-0033","n":33,"text":"முலைப் பூசல்கேட்டு ஆங்கடைக்கலமிழந் துயிரிழந்த","who":[],"rec":[]},{"id":"SIL-29-0034","n":34,"text":"இடைக்குல மகளிடமெய்தி ஐயையவள் மகளோடும்","who":[],"rec":[]},{"id":"SIL-29-0035","n":35,"text":"வையையொரு வழிக்கொண்டு மாமலை மீமிசையேறிக்","who":[],"rec":[]},{"id":"SIL-29-0036","n":36,"text":"கோமகடன் கோயில்புக்கு நங்கைக்குச் சிறப்பயர்ந்த","who":[],"rec":["v065"]},{"id":"SIL-29-0037","n":37,"text":"செங்குட்டுவற்குத் திறமுரைப்பர் மன்;","who":["cenkuttuvan"],"rec":["v065"]},{"id":"SIL-29-0038","n":38,"text":"தேவந்தி சொல்","who":["tevanti"],"rec":[]},{"id":"SIL-29-0039","n":39,"text":"முடிமன்னர் மூவருங் காத்தோம்புந் தெய்வ","who":[],"rec":[]},{"id":"SIL-29-0040","n":40,"text":"வட