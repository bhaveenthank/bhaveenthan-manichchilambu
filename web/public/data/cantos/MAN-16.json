[{"id":"MAN-16-0001","n":1,"text":"'ஈங்கு இவள் செய்தி கேள்' என விஞ்சையர்","who":[],"rec":[]},{"id":"MAN-16-0002","n":2,"text":"பூங்கொடி மாதர்க்குப் புகுந்ததை உரைப்போள்","who":[],"rec":[]},{"id":"MAN-16-0003","n":3,"text":"'ஆதிரை கணவன் ஆய் இழை! கேளாய்","who":["aticari"],"rec":[]},{"id":"MAN-16-0004","n":4,"text":"சாதுவன் என்போன் தகவு இலன் ஆகி","who":[],"rec":[]},{"id":"MAN-16-0005","n":5,"text":"அணி இழை தன்னை அகன்றனன் போகி","who":[],"rec":[]},{"id":"MAN-16-0006","n":6,"text":"கணிகை ஒருத்தி கைத்தூண் நல்க","who":[],"rec":[]},{"id":"MAN-16-0007","n":7,"text":"வட்டினும் சூதினும் வான் பொருள் வழங்கி","who":[],"rec":[]},{"id":"MAN-16-0008","n":8,"text":"கெட்ட பொருளின் கிளை கேடுறுதலின்","who":[],"rec":[]},{"id":"MAN-16-0009","n":9,"text":"பேணிய கணிகையும் பிறர் நலம் காட்டி","who":[],"rec":[]},{"id":"MAN-16-0010","n":10,"text":"\"காணம் இலி\" என கையுதிர்க்கோடலும்","who":[],"rec":[]},{"id":"MAN-16-0011","n":11,"text":"வங்கம் போகும் வாணிகர் தம்முடன்","who":[],"rec":[]},{"id":"MAN-16-0012","n":12,"text":"தங்கா வேட்கையின் தானும் செல்வுழி","who":[],"rec":[]},{"id":"MAN-16-0013","n":13,"text":"நளி இரு முந்நீர் வளி கலன் வௌவ","who":[],"rec":["n60"]},{"id":"MAN-16-0014","n":14,"text":"ஒடி மரம் பற்றி ஊர் திரை உதைப்ப","who":[],"rec":["n60"]},{"id":"MAN-16-0015","n":15,"text":"நக்க சாரணர் நாகர் வாழ் மலைப்","who":[],"rec":["n60"]},{"id":"MAN-16-0016","n":16,"text":"பக்கம் சார்ந்து அவர் பான்மையன் ஆயினன்","who":[],"rec":[]},{"id":"MAN-16-0017","n":17,"text":"நாவாய் கேடுற நல் மரம் பற்றிப்","who":[],"rec":[]},{"id":"MAN-16-0018","n":18,"text":"போயினன் தன்னோடு உயிர் உயப் போந்தோர்","who":[],"rec":[]},{"id":"MAN-16-0019","n":19,"text":"\"இடை இருள் யாமத்து எறி திரைப் பெருங் கடல்","who":[],"rec":[]},{"id":"MAN-16-0020","n":20,"text":"உடை கலப் பட்டு ஆங்கு ஒழிந்தோர் தம்முடன்","who":[],"rec":[]},{"id":"MAN-16-0021","n":21,"text":"சாதுவன் தானும் சாவுற்றான்\" என","who":[],"rec":[]},{"id":"MAN-16-0022","n":22,"text":"ஆதிரை நல்லாள் ஆங்கு அது தான் கேட்டு","who":["aticari"],"rec":[]},{"id":"MAN-16-0023","n":23,"text":"\"ஊரீரேயோ! ஒள் அழல் ஈமம்","who":[],"rec":[]},{"id":"MAN-16-0024","n":24,"text":"தாரீரோ?\" எனச் சாற்றினள் கழறி","who":[],"rec":[]},{"id":"MAN-16-0025","n":25,"text":"சுடலைக் கானில் தொடு குழிப்படுத்து","who":[],"rec":[]},{"id":"MAN-16-0026","n":26,"text":"முடலை விறகின் முளி எரி பொத்தி","who":[],"rec":[]},{"id":"MAN-16-0027","n":27,"text":"\"மிக்க என் கணவன் வினைப் பயன் உய்ப்பப்","who":[],"rec":[]},{"id":"MAN-16-0028","n":28,"text":"புக்குழிப் புகுவேன்\" என்று அவள் புகுதலும்","who":[],"rec":[]},{"id":"MAN-16-0029","n":29,"text":"படுத்து உடன் வைத்த பாயல் பள்ளியும்","who":[],"rec":[]},{"id":"MAN-16-0030","n":30,"text":"உடுத்த கூறையும் ஒள் எரி உறா அது","who":[],"rec":[]},{"id":"MAN-16-0031","n":31,"text":"ஆடிய சாந்தமும் அசைந்த கூந்தலில்","who":[],"rec":[]},{"id":"MAN-16-0032","n":32,"text":"சூடிய மாலையும் தொல் நிறம் வழாது","who":[],"rec":[]},{"id":"MAN-16-0033","n":33,"text":"விரை மலர்த் தாமரை ஒரு தனி இருந்த","who":[],"rec":[]},{"id":"MAN-16-0034","n":34,"text":"திருவின் செய்யோள் போன்று இனிது இருப்பத்","who":[],"rec":[]},{"id":"MAN-16-0035","n":35,"text":"\"தீயும் கொல்லாத் தீவினையாட்டியேன்","who":[],"rec":[]},{"id":"MAN-16-0036","n":36,"text":"யாது செய்கேன்?\" என்று அவள் ஏங்கலும்","who":[],"rec":[]},{"id":"MAN-16-0037","n":37,"text":"\"ஆதிரை! கேள் உன் அரும் பெறல் கணவனை","who":["aticari"],"rec":[]},{"id":"MAN-16-0038","n":38,"text":"ஊர் திரை கொண்டு ஆங்கு உய்ப்பப் போகி","who":[],"rec":[]},{"id":"MAN-16-0039","n":39,"text":"நக்க சாரணர் நாகர் வாழ் மலைப்","who":[],"rec":[]},{"id":"MAN-16-0040","n":40,"text":"பக்கம் சேர்ந்தனன் பல் யாண்டு இராஅன்","who":[],"rec":[]},{"id":"MAN-16-0041","n":41,"text":"சந்திரதத்தன் எனும் ஓர் வாணிகன்","who":[],"rec":[]},{"id":"MAN-16-0042","n":42,"text":"வங்கம் தன்னொடும் வந்தனன் தோன்றும்","who":[],"rec":[]},{"id":"MAN-16-0043","n":43,"text":"நின் பெருந் துன்பம் ஒழிவாய் நீ\" என","who":[],"rec":[]},{"id":"MAN-16-0044","n":44,"text":"அந்தரம் தோன்றி அசரீரி அறைதலும்","who":[],"rec":[]},{"id":"MAN-16-0045","n":45,"text":"ஐ அரி உண் கண் அழு துயர் நீங்கி","who":[],"rec":[]},{"id":"MAN-16-0046","n":46,"text":"பொய்கை புக்கு ஆடிப் போதுவாள் போன்று","who":[],"rec":[]},{"id":"MAN-16-0047","n":47,"text":"மனம் கவல்வு இன்றி மனைஅகம் புகுந்து \"என்","who":[],"rec":[]},{"id":"MAN-16-0048","n":48,"text":"கண் மணி அனையான் கடிது ஈங்கு உறுக!\" என","who":[],"rec":[]},{"id":"MAN-16-0049","n":49,"text":"புண்ணியம் முட்டாள் பொழி மழை தரூஉம்","who":[],"rec":[]},{"id":"MAN-16-0050","n":50,"text":"அரும் பெறல் மரபின் பத்தினிப் பெண்டிரும்","who":[],"rec":[]},{"id":"MAN-16-0051","n":51,"text":"விரும்பினர் தொழூஉம் வியப்பினள் ஆயினள்","who":[],"rec":[]},{"id":"MAN-16-0052","n":52,"text":"ஆங்கு அவள் கணவனும் அலைநீர் அடைகரை","who":[],"rec":[]},{"id":"MAN-16-0053","n":53,"text":"ஓங்கு உயர் பிறங்கல் ஒரு மர நீழல்","who":[],"rec":[]},{"id":"MAN-16-0054","n":54,"text":"மஞ்சு உடை மால் கடல் உழந்த நோய் கூர்ந்து","who":[],"rec":[]},{"id":"MAN-16-0055","n":55,"text":"துஞ்சு துயில்கொள்ள அச் சூர் மலை வாழும்","who":[],"rec":[]},{"id":"MAN-16-0056","n":56,"text":"நக்க சாரணர் நயமிலர் தோன்றி","who":[],"rec":[]},{"id":"MAN-16-0057","n":57,"text":"பக்கம் சேர்ந்து \"பரி புலம்பினன் இவன்","who":[],"rec":[]},{"id":"MAN-16-0058","n":58,"text":"தானே தமியன் வந்தனன் அளியன்","who":[],"rec":[]},{"id":"MAN-16-0059","n":59,"text":"ஊன் உடை இவ் உடம்பு உணவு\" என்று எழுப்பலும்","who":[],"rec":[]},{"id":"MAN-16-0060","n":60,"text":"மற்று அவர் பாடை மயக்கு அறு மரபின்","who":[],"rec":["n61"]},{"id":"MAN-16-0061","n":61,"text":"கற்றனன் ஆதலின் கடுந் தொழில் மாக்கள்","who":[],"rec":["n61"]},{"id":"MAN-16-0062","n":62,"text":"சுற்றும் நீங்கித் தொழுது உரையாடி","who":[],"rec":["n61"]},{"id":"MAN-16-0063","n":63,"text":"ஆங்கு அவர் உரைப்போர் \"அருந்திறல்! கேளாய்","who":[],"rec":[]},{"id":"MAN-16-0064","n":64,"text":"ஈங்கு எம் குருமகன் இருந்தோன் அவன்பால்","who":[],"rec":[]},{"id":"MAN-16-0065","n":65,"text":"போந்தருள் நீ\" என அவருடன் போகி","who":[],"rec":[]},{"id":"MAN-16-0066","n":66,"text":"கள் அடு குழிசியும் கழி முடை நாற்றமும்","who":[],"rec":[]},{"id":"MAN-16-0067","n":67,"text":"வெள் எ