ext":"வேந்தரை அட்டோன் மெல் இயல் தேர்வுழி","who":[],"rec":[]},{"id":"MAN-24-0046","n":46,"text":"நிலத்தில் குளித்து நெடு விசும்பு ஏறி","who":[],"rec":[]},{"id":"MAN-24-0047","n":47,"text":"சலத்தில் திரியும் ஓர் சாரணன் தோன்ற","who":[],"rec":[]},{"id":"MAN-24-0048","n":48,"text":"மன்னவன் அவனை வணங்கி முன் நின்று","who":[],"rec":[]},{"id":"MAN-24-0049","n":49,"text":"\"என் உயிர் அனையாள் ஈங்கு ஒளித்தாள் உளள்","who":[],"rec":[]},{"id":"MAN-24-0050","n":50,"text":"அன்னாள் ஒருத்தியைக் கண்டிரோ அடிகள்?","who":[],"rec":[]},{"id":"MAN-24-0051","n":51,"text":"சொல்லுமின்\" என்று தொழ அவன் உரைப்பான்","who":[],"rec":[]},{"id":"MAN-24-0052","n":52,"text":"\"கண்டிலேன் ஆயினும் காரிகை தன்னைப்","who":[],"rec":[]},{"id":"MAN-24-0053","n":53,"text":"பண்டு அறிவுடையேன் பார்த்திப கேளாய்","who":[],"rec":[]},{"id":"MAN-24-0054","n":54,"text":"நாக நாடு நடுக்கு இன்று ஆள்பவன்","who":[],"rec":[]},{"id":"MAN-24-0055","n":55,"text":"வாகை வேலோன் வளைவணன் தேவி","who":[],"rec":[]},{"id":"MAN-24-0056","n":56,"text":"வாசமயிலை வயிற்றுள் தோன்றிய","who":[],"rec":[]},{"id":"MAN-24-0057","n":57,"text":"பீலிவளை என்போள் பிறந்த அந் நாள்","who":[],"rec":[]},{"id":"MAN-24-0058","n":58,"text":"\"இரவி குலத்து ஒருவன் இணை முலை தோய","who":[],"rec":[]},{"id":"MAN-24-0059","n":59,"text":"கருவொடு வரும்\" எனக் கணி எடுத்து உரைத்தனன்","who":[],"rec":[]},{"id":"MAN-24-0060","n":60,"text":"ஆங்கு அப் புதல்வன் வரூஉம் அல்லது","who":[],"rec":[]},{"id":"MAN-24-0061","n":61,"text":"பூங்கொடி வாராள் புலம்பல்! இது கேள்","who":[],"rec":[]},{"id":"MAN-24-0062","n":62,"text":"தீவகச் சாந்தி செய்யா நாள் உன்","who":[],"rec":[]},{"id":"MAN-24-0063","n":63,"text":"காவல் மா நகர் கடல் வயிறு புகூஉம்","who":[],"rec":[]},{"id":"MAN-24-0064","n":64,"text":"மணிமேகலை தன் வாய்மொழியால் அது","who":["manimekalai"],"rec":[]},{"id":"MAN-24-0065","n":65,"text":"தணியாது இந்திர சாபம் உண்டு ஆகலின்","who":[],"rec":[]},{"id":"MAN-24-0066","n":66,"text":"ஆங்குப் பதி அழிதலும் ஈங்குப் பதி கெடுதலும்","who":[],"rec":[]},{"id":"MAN-24-0067","n":67,"text":"வேந்தரை அட்டோய்!