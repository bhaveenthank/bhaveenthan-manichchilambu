c":[]},{"id":"MAN-10-0088","n":88,"text":"'மறந்ததும் உண்டு' என மறித்து ஆங்கு இழிந்து","who":[],"rec":[]},{"id":"MAN-10-0089","n":89,"text":"'சிறந்த கொள்கைச் சேயிழை! கேளாய்","who":[],"rec":[]},{"id":"MAN-10-0090","n":90,"text":"மக்கள் யாக்கை உணவின் பிண்டம்","who":[],"rec":[]},{"id":"MAN-10-0091","n":91,"text":"இப் பெரு மந்திரம் இரும் பசி அறுக்கும்' என்று","who":[],"rec":[]},{"id":"MAN-10-0092","n":92,"text":"ஆங்கு அது கொடுத்து ஆங்கு அந்தரம் எழுந்து","who":[],"rec":[]},{"id":"MAN-10-0093","n":93,"text":"நீங்கியது ஆங்கு நெடுந் தெய்வம் தான் என்","who":[],"rec":[]}]